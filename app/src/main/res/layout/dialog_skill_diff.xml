<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ Gemini Suggested Skill Optimization"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvDiffSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Review prompt and configuration changes below:"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="12dp" />

        <!-- Container for Step Comparisons -->
        <LinearLayout
            android:id="@+id/containerStepDiffs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp" />

        <!-- Toggle Raw JSON -->
        <Button
            android:id="@+id/btnToggleRawJson"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show Raw JSON Diff"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvRawJsonDiff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:visibility="gone"
            android:background="#F0F0F0"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnDismissDiff"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dismiss"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnAcceptAndRerun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accept &amp; Re-Run" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
