<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI &amp; Local Model Settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gemma Local Model Path / Status:"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/etGemmaModelPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. /sdcard/gemma.bin or select model file" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gemma Model Download URL:"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/etGemmaModelUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://huggingface.co/..." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnSelectGemmaModel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select File"
                android:layout_marginEnd="2dp"/>

            <Button
                android:id="@+id/btnDownloadGemmaModel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Download Model"
                android:layout_marginHorizontal="2dp"/>

            <Button
                android:id="@+id/btnCheckGemmaStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Check Status"
                android:layout_marginStart="2dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveAiSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save AI Settings"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>
