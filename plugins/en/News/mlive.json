{
  "domainPattern": ".*mlive\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "article.entry-content",
    "div.article__body",
    "article",
    "main"
  ],
  "titlePath": [
    "h1.entry-title",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "MLive",
  "classification": {
    "defaultCategory": "News",
    "rssRules": [
      {
        "source": "URL_REGEX",
        "pattern": "^https?://[^/]+/([^/]+)(?:/([^/]+))?/\\d{4}/\\d{2}/",
        "categoryGroup": 1,
        "subcategoryGroup": 2
      },
      {
        "source": "RSS_FIELD_REGEX",
        "field": "content_html",
        "pattern": "(pc_aff_link=|skimresources\\.com|irmp=|catena|bettercollective)",
        "assignTag": "affiliate"
      }
    ],
    "categoryMap": {
      "news": "News",
      "politics": "News",
      "public-interest": "News",
      "business": "Business",
      "weather": "Weather",
      "highschoolsports": "Sports",
      "sports": "Sports",
      "wolverines": "Sports",
      "spartans": "Sports",
      "lions": "Sports",
      "tigers": "Sports",
      "redwings": "Sports",
      "pistons": "Sports",
      "sports-betting": "Gambling",
      "online-casinos": "Gambling",
      "sweepstakes-casinos": "Gambling",
      "tv": "Entertainment",
      "a-e": "Entertainment",
      "shopping": "Shopping",
      "life": "Lifestyle",
      "opinion": "Opinion",
      "griffins": "Sports"
    },
    "dropIfCategoryIn": [
      "Sports",
      "Gambling",
      "Entertainment",
      "Shopping",
      "Lifestyle",
      "Opinion"
    ],
    "dropIfTagIn": [
      "affiliate"
    ]
  }
}
