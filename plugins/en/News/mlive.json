{
  "domainPattern": ".*mlive\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "article.entry-content",
    "div.article__body",
    "article",
    "main"
  ],
  "titlePath": [
    "h1.entry-title",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "MLive"
}
