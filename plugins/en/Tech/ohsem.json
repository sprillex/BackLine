{
  "domainPattern": ".*ohsem\\.me",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "div.tdb-block-inner",
    "div#td-outer-wrap",
    "article"
  ],
  "titlePath": [
    "h1.tdb-title-text",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "Ohsem.me"
}