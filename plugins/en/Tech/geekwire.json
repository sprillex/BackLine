{
  "domainPattern": ".*geekwire\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "div.entry-content",
    "article"
  ],
  "titlePath": [
    "h1.entry-title",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "GeekWire"
}