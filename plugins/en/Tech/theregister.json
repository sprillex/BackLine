{
  "domainPattern": ".*theregister\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "section#mainArticleSection",
    "article",
    "main"
  ],
  "titlePath": [
    "h1.headline",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "The Register"
}