{
  "domainPattern": ".*venturebeat\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "div.article-content",
    "article",
    "main"
  ],
  "titlePath": [
    "h1.article-title",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "VentureBeat"
}