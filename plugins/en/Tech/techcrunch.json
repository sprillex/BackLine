{
  "domainPattern": ".*techcrunch\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": "div.entry-content",
  "titlePath": "h1.wp-block-post-title",
  "injectRssImage": true,
  "removeSelectors": [
    ".wp-block-social-links",
    ".wp-block-techcrunch-social-share__link",
    ".wp-block-tc23-post-relevant-terms",
    "h2:contains(Related)",
    "iframe",
    "script",
    "div.ad",
    "div.ad-container",
    "div.widget"
  ],
  "sourceName": "TechCrunch"
}
