{
  "domainPattern": ".*techrepublic\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "div.article-content",
    "div.wrapper",
    "article"
  ],
  "titlePath": [
    "h1.h1",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "TechRepublic"
}