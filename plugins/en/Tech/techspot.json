{
  "domainPattern": ".*techspot\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "div.article-body",
    "div#GlobalWrapper",
    "article"
  ],
  "titlePath": [
    "h1.large",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "TechSpot"
}