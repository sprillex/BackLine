{
  "domainPattern": ".*nocamels\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "div.post-content",
    "main#main-content",
    "article"
  ],
  "titlePath": [
    "h1.post-title",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "NoCamels"
}