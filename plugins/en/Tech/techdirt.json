{
  "domainPattern": ".*techdirt\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "div.postbody",
    "div#wrapper",
    "article"
  ],
  "titlePath": [
    "h1.posttitle",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "Techdirt"
}