{
  "domainPattern": ".*techfeeddata\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "div.entry-content",
    "div.wp-site-blocks",
    "article"
  ],
  "titlePath": [
    "h1.wp-block-post-title",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "Tech Feed Data"
}