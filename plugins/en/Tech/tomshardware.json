{
  "domainPattern": ".*tomshardware\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "div#article-body",
    "article",
    "main"
  ],
  "titlePath": [
    "h1",
    "h1.article-header-title"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "Tom's Hardware"
}
