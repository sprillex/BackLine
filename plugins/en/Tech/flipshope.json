{
  "domainPattern": ".*flipshope\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "div.cs-entry__content",
    "div#page",
    "article"
  ],
  "titlePath": [
    "h1.cs-entry__title",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "Flipshope"
}