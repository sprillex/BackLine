{
  "domainPattern": ".*nextgov\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "div.wysiwyg",
    "div#wrapper",
    "article"
  ],
  "titlePath": [
    "h1.content-title",
    "h1"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "Nextgov/FCW"
}