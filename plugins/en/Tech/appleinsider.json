{
  "domainPattern": ".*appleinsider\\.com",
  "strategy": "CSS_SELECTOR",
  "contentPath": [
    "div.article-body",
    "div.site-container",
    "article"
  ],
  "titlePath": [
    "h1",
    "h1.article-title"
  ],
  "injectRssImage": true,
  "removeSelectors": [
    "iframe",
    "script",
    "div.ad",
    "div.widget",
    "div.social-share",
    ".share",
    ".newsletter-signup"
  ],
  "sourceName": "AppleInsider"
}